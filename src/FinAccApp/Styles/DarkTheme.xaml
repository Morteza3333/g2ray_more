<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="PrimaryColor">#6BA4E8</Color>
    <Color x:Key="AccentColor">#B07CE8</Color>
    <Color x:Key="SuccessColor">#58D68D</Color>
    <Color x:Key="WarningColor">#F4D03F</Color>
    <Color x:Key="DangerColor">#EC7063</Color>
    <Color x:Key="InfoColor">#5DADE2</Color>

    <Color x:Key="WindowBgColor">#0F172A</Color>
    <Color x:Key="GlassBgColor">#1E293B</Color>
    <Color x:Key="GlassBorderColor">#334155</Color>
    <Color x:Key="TextColor">#F8FAFC</Color>
    <Color x:Key="MutedTextColor">#94A3B8</Color>
    <Color x:Key="SidebarBgColor">#1E293B</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>

    <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBgColor}"/>
    <SolidColorBrush x:Key="GlassBgBrush" Color="{StaticResource GlassBgColor}" Opacity="0.75"/>
    <SolidColorBrush x:Key="GlassBorderBrush" Color="{StaticResource GlassBorderColor}" Opacity="0.8"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}"/>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBgColor}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="#1E293B"/>
</ResourceDictionary>